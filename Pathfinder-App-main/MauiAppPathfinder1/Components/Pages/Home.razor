        }
        <DxGridDataColumn FieldName="Dateiname" Caption="Dateiname"></DxGridDataColumn>


        <DxGridDataColumn FieldName="PathExists" Caption="Path Exists" Width="67"  >
              <CellDisplayTemplate  Context="displayContext" >
                @{
                    int iv = displayContext.VisibleIndex;
                    if (iv >= 0)
                    {
                        var editModel = (ProDocument)displayContext.Grid.GetDataItem(iv);
                        if (editModel != null)
                        {
                            Testtrue2 = editModel.PathExists;
                            int idKey = editModel.Id;
                        }
                    }
                    else { Testtrue2 = false; }

                }

            <label class="switch">

                    <InputCheckbox @ref="InputCheckboxSel31" @bind-Value="@Testtrue2"  ></InputCheckbox>
