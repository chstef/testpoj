<DxGrid @ref="ProGrid" Data="@SData" ShowSearchBox=true 
    SearchBoxNullText="Search for Filesentry" 
    AllowSort="true"
        AllowSelectRowByClick="true" PageSize="7"
        SelectionMode="GridSelectionMode.Single" 
        @bind-SelectedDataItem="@SelectedDataItem"
        EditMode="GridEditMode.EditRow"
